// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Profiles & Auth ─────────────────────────────────────────────────────────

model Profile {
  id         String   @id // Maps to Supabase auth.users.id
  email      String   @unique
  name       String
  role       Role
  avatarUrl  String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student        Student?
  faculty        Faculty?
  leaveRequests  LeaveRequest[]
  communityPosts CommunityPost[]
  chatSessions   ChatSession[]
  notifications  Notification[]

  @@map("profiles")
}

enum Role {
  student
  faculty
  admin
}

// ─── Student / Faculty ───────────────────────────────────────────────────────

model Student {
  id         String   @id @default(uuid())
  profileId  String   @unique
  rollNumber String   @unique
  semester   Int
  section    String?
  batch      String?

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendances Attendance[]
  grades      Grade[]
  submissions Submission[]
  feeRecords  FeeRecord[]

  @@map("students")
}

model Faculty {
  id         String   @id @default(uuid())
  profileId  String   @unique
  employeeId String   @unique

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courses Course[]
  notices Notice[]

  @@map("faculty")
}

// ─── Courses & Schedules ──────────────────────────────────────────────────────

model Course {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  credits    Int
  semester   Int
  department String
  facultyId  String

  faculty     Faculty      @relation(fields: [facultyId], references: [id])
  enrollments Enrollment[]
  attendances Attendance[]
  assignments Assignment[]
  grades      Grade[]
  schedules   Schedule[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Schedule {
  id        String    @id @default(uuid())
  courseId  String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String

  course Course @relation(fields: [courseId], references: [id])

  @@map("schedules")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  courseId  String
  date      DateTime         @db.Date
  status    AttendanceStatus
  markedBy  String?

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  present
  absent
  late
}

// ─── Assignments & Submissions ───────────────────────────────────────────────

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Int      @default(100)
  createdAt   DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id            String           @id @default(uuid())
  assignmentId  String
  studentId     String
  fileUrl       String?
  marksObtained Int?
  submittedAt   DateTime         @default(now())
  status        SubmissionStatus @default(pending)

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

enum SubmissionStatus {
  pending
  submitted
  graded
  late
}

// ─── Academic Grades ─────────────────────────────────────────────────────────

model Grade {
  id              String   @id @default(uuid())
  studentId       String
  courseId        String
  semester        Int
  internalMarks   Float?
  assignmentMarks Float?
  externalMarks   Float?
  grade           String?
  createdAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, semester])
  @@map("grades")
}

// ─── Leave Requests ───────────────────────────────────────────────────────────

model LeaveRequest {
  id         String      @id @default(uuid())
  profileId  String
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String
  leaveType  LeaveType
  status     LeaveStatus @default(pending)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  profile Profile @relation(fields: [profileId], references: [id])

  @@map("leave_requests")
}

enum LeaveType {
  medical
  personal
  academic
  emergency
}

enum LeaveStatus {
  pending
  approved
  rejected
}

// ─── Notices & Community ──────────────────────────────────────────────────────

model Notice {
  id         String         @id @default(uuid())
  facultyId  String
  title      String
  content    String
  category   NoticeCategory
  targetRole Role?
  createdAt  DateTime       @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id])

  @@map("notices")
}

enum NoticeCategory {
  academic
  event
  administrative
  general
}

model CommunityPost {
  id        String   @id @default(uuid())
  profileId String
  content   String
  imageUrl  String?
  tags      String[]
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id])

  @@map("community_posts")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  category    String?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@map("events")
}

model Notification {
  id        String   @id @default(uuid())
  profileId String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id])

  @@map("notifications")
}

// ─── Chat Sessions & Messages ────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(uuid())
  profileId String
  createdAt DateTime      @default(now())

  profile  Profile       @relation(fields: [profileId], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}

enum MessageRole {
  user
  assistant
}

// ─── RAG AI Knowledge Base & Vector Store ─────────────────────────────────────

model KnowledgeDocument {
  id         String   @id @default(uuid())
  title      String
  category   String?
  sourceType String   @default("text")
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())

  chunks DocumentChunk[]

  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  metadata   String?
  embedding  Float[]

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

// ─── Fee Management System ───────────────────────────────────────────────────

model FeeRecord {
  id          String    @id @default(uuid())
  studentId   String
  semester    Int
  tuitionFee  Float
  hostelFee   Float     @default(0)
  examFee     Float     @default(0)
  totalAmount Float
  status      FeeStatus @default(pending)
  dueDate     DateTime
  paidAt      DateTime?
  receiptUrl  String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("fee_records")
}

enum FeeStatus {
  pending
  paid
  overdue
}

// ─── Audit Logging System ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
